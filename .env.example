# ---------------------------------------------------------------------------
# ONE Google Apps Script Web App handles BOTH RSVP and Wishes
# (see google-apps-script/Code.gs). Copy this file to `.env.local`
# and paste your single deployment URL (…/exec) below.
# Leave empty to fall back to local browser storage.
# ---------------------------------------------------------------------------

# Single deployment URL — used for RSVP (POST type:"rsvp") and
# Wishes (POST type:"wish" + GET ?action=wishes).
NEXT_PUBLIC_RSVP_ENDPOINT=

# Optional override if you ever host Wishes on a different deployment.
# Leave empty to reuse NEXT_PUBLIC_RSVP_ENDPOINT above.
NEXT_PUBLIC_WISHES_ENDPOINT=
